{
    "name": "echocare/fundraising-platform",
    "description": "EchoCare - Fundraising Activity Platform",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0",
        "symfonycorp/security-checker": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "EchoCare\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint-fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "security": "security-checker check composer.lock",
        "qa": [
            "@lint",
            "@stan",
            "@test",
            "@security"
        ]
    }
}
